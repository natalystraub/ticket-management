PORT=3001
# Postgres local ou hospedado (Neon, Supabase, Render, Railway...)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/tickets
# true em bancos hospedados que exigem SSL
DATABASE_SSL=false
# URL do front (CORS). Em producao: URL da Vercel
FRONT_URL=http://localhost:5173
# Webhook do Power Automate (gatilho HTTP)
POWER_AUTOMATE_URL=
